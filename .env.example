# === Supabase (always required) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Site Info ===
NEXT_PUBLIC_SITE_NAME="ILEA Lifestyle Experience Series"
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# === Email ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
FROM_EMAIL=noreply@ilea.com
FROM_NAME="ILEA Lifestyle Experience Series"

# === HitPay ===
HITPAY_API_KEY=your-hitpay-api-key
HITPAY_SALT=your-hitpay-salt
HITPAY_WEBHOOK_SECRET=your-webhook-secret
HITPAY_ENV=sandbox

# === Google Sheets ===
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
